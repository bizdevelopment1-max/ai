  "apiConnectors": [
    {
      "id": "sec-edgar-current-filings",
      "source": "SEC EDGAR",
      "sourceTier": "official",
      "category": "filing",
      "endpoint": "https://www.sec.gov/cgi-bin/browse-edgar?action=getcurrent&output=atom&type=8-k",
      "format": "atom",
      "requiredEnv": ["SEC_USER_AGENT"],
      "schedule": "hourly"
    },
    {
      "id": "uspto-open-data",
      "source": "USPTO Open Data Portal",
      "sourceTier": "official",
      "category": "patent",
      "endpoint": "https://api.uspto.gov/api/v1/patent/applications/search",
      "format": "json",
      "requiredEnv": ["USPTO_API_KEY"],
      "schedule": "daily"
    },
    {
      "id": "wipo-patentscope",
      "source": "WIPO PATENTSCOPE",
      "sourceTier": "official",
      "category": "patent",
      "endpoint": "https://patentscope.wipo.int/search/en/search.jsf",
      "format": "licensed-query",
      "requiredEnv": ["WIPO_PATENTSCOPE_USER", "WIPO_PATENTSCOPE_PASSWORD"],
      "schedule": "daily"
    },
    {
      "id": "sensor-tower-store-intelligence",
      "source": "Sensor Tower API",
      "sourceTier": "official",
      "category": "app-economics",
      "endpoint": "https://api.sensortower.com/v1/",
      "format": "json",
      "requiredEnv": ["SENSOR_TOWER_TOKEN"],
      "schedule": "daily"
    },
    {
      "id": "appfigures-app-intelligence",
      "source": "Appfigures API",
      "sourceTier": "official",
      "category": "app-economics",
      "endpoint": "https://api.appfigures.com/v2/",
      "format": "json",
      "requiredEnv": ["APPFIGURES_CLIENT_KEY", "APPFIGURES_ACCESS_TOKEN"],
      "schedule": "daily"
    }
