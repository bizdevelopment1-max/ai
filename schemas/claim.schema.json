{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bizdevelopment1-max.github.io/ai/schemas/claim.schema.json",
  "title": "Evidence-grounded bitemporal claim",
  "type": "object",
  "required": [
    "claimId", "entityId", "predicate", "claimType", "value",
    "evidenceSpanIds", "documentIds", "observedAt", "retrievedAt", "verifiedAt",
    "workflowStage", "reviewStatus", "verificationStatus", "taxonomy", "extraction"
  ],
  "properties": {
    "claimId": { "type": "string", "minLength": 8 },
    "entityId": { "type": "string", "minLength": 2 },
    "predicate": { "type": "string", "minLength": 2 },
    "claimType": { "type": "string", "enum": ["fact", "implication", "decision", "opportunity-assessment"] },
    "value": {},
    "unit": { "type": "string" },
    "evidenceSpanIds": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 8 } },
    "documentIds": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 8 } },
    "eventAt": { "type": ["string", "null"] },
    "publishedAt": { "type": ["string", "null"] },
    "observedAt": { "type": "string", "minLength": 10 },
    "retrievedAt": { "type": "string", "minLength": 10 },
    "verifiedAt": { "type": "string", "minLength": 10 },
    "validFrom": { "type": ["string", "null"] },
    "validTo": { "type": ["string", "null"] },
    "systemFrom": { "type": "string", "minLength": 10 },
    "systemTo": { "type": ["string", "null"] },
    "workflowStage": { "type": "string", "enum": ["raw", "draft", "verified", "reviewed", "published", "reconciled"] },
    "reviewStatus": { "type": "string", "enum": ["unreviewed", "approved", "rejected", "superseded"] },
    "reviewerId": { "type": ["string", "null"] },
    "confidence": { "type": "string", "enum": ["low", "medium", "high"] },
    "verificationStatus": { "type": "string", "enum": ["draft", "verified"] },
    "taxonomy": { "type": "object" },
    "extraction": {
      "type": "object",
      "required": ["method", "extractorVersion"],
      "properties": {
        "method": { "type": "string", "minLength": 3 },
        "extractorVersion": { "type": "string", "minLength": 3 }
      }
    },
    "supersedesId": { "type": ["string", "null"] },
    "correctionReason": { "type": ["string", "null"] }
  }
}
