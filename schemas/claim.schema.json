{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bizdevelopment1-max.github.io/ai/schemas/claim.schema.json",
  "title": "Evidence-grounded claim",
  "type": "object",
  "required": ["claimId", "entityId", "predicate", "evidenceSpanIds", "observedAt", "reviewStatus"],
  "properties": {
    "claimId": { "type": "string", "minLength": 4 },
    "entityId": { "type": "string", "minLength": 2 },
    "predicate": { "type": "string", "minLength": 2 },
    "evidenceSpanIds": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 2 } },
    "observedAt": { "type": "string", "minLength": 10 },
    "sourceOwnerGroup": { "type": "string" },
    "syndicationClusterId": { "type": "string" },
    "reviewStatus": { "type": "string", "enum": ["unreviewed", "approved", "rejected", "superseded"] }
  }
}
