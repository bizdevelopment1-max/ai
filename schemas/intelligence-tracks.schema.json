{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bizdevelopment1-max.github.io/ai/schemas/intelligence-tracks.schema.json",
  "title": "Cumulative intelligence track snapshot",
  "type": "object",
  "required": ["schemaVersion", "generatedAt", "policyVersion", "tracks", "summary", "reverificationQueue"],
  "properties": {
    "schemaVersion": { "type": "integer", "minimum": 1 },
    "generatedAt": { "type": "string", "minLength": 10 },
    "policyVersion": { "type": "integer", "minimum": 1 },
    "summary": {
      "type": "object",
      "required": ["trackCount", "recordCount", "sourceBackedCount", "newVersionCount"]
    },
    "tracks": {
      "type": "object",
      "required": ["company", "market", "consumer-survey", "value-chain"],
      "properties": {
        "company": { "$ref": "#/$defs/track" },
        "market": { "$ref": "#/$defs/track" },
        "consumer-survey": { "$ref": "#/$defs/track" },
        "value-chain": { "$ref": "#/$defs/track" }
      }
    },
    "reverificationQueue": {
      "type": "object",
      "required": ["total", "records"],
      "properties": {
        "total": { "type": "integer", "minimum": 0 },
        "records": { "type": "array", "items": { "$ref": "#/$defs/reverification" } }
      }
    }
  },
  "$defs": {
    "track": {
      "type": "object",
      "required": ["id", "label", "recordCount", "sourceBackedCount", "sourceBackedRatio", "newVersionCount", "records"],
      "properties": {
        "id": { "type": "string", "minLength": 3 },
        "label": { "type": "string", "minLength": 2 },
        "recordCount": { "type": "integer", "minimum": 0 },
        "sourceBackedCount": { "type": "integer", "minimum": 0 },
        "sourceBackedRatio": { "type": "number", "minimum": 0 },
        "newVersionCount": { "type": "integer", "minimum": 0 },
        "records": { "type": "array", "items": { "$ref": "#/$defs/record" } }
      }
    },
    "record": {
      "type": "object",
      "required": ["track", "stableKey", "versionKey", "revision", "payloadHash", "title", "evidenceStatus", "firstSeenAt", "lastSeenAt", "payload"],
      "properties": {
        "track": { "type": "string", "minLength": 3 },
        "stableKey": { "type": "string", "minLength": 4 },
        "versionKey": { "type": "string", "minLength": 12 },
        "revision": { "type": "integer", "minimum": 1 },
        "payloadHash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "title": { "type": "string", "minLength": 1 },
        "sourceUrl": { "type": "string" },
        "evidenceStatus": { "enum": ["source-backed", "reference-only"] },
        "firstSeenAt": { "type": "string", "minLength": 10 },
        "lastSeenAt": { "type": "string", "minLength": 10 },
        "payload": { "type": "object" }
      }
    },
    "reverification": {
      "type": "object",
      "required": ["track", "stableKey", "priority", "reason"],
      "properties": {
        "track": { "type": "string" },
        "stableKey": { "type": "string" },
        "priority": { "enum": ["P0", "P1", "P2"] },
        "reason": { "type": "string" }
      }
    }
  }
}
