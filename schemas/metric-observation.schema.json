{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bizdevelopment1-max.github.io/ai/schemas/metric-observation.schema.json",
  "title": "Comparable metric observation",
  "type": "object",
  "required": ["metricId", "metricName", "value", "unit", "observedAt", "evidenceSpanId"],
  "properties": {
    "metricId": { "type": "string", "minLength": 4 },
    "metricName": { "type": "string", "minLength": 2 },
    "value": { "type": "number" },
    "unit": { "type": "string", "minLength": 1 },
    "currency": { "type": "string" },
    "geography": { "type": "string" },
    "period": { "type": "string" },
    "population": { "type": "string" },
    "channel": { "type": "string" },
    "observedAt": { "type": "string", "minLength": 10 },
    "evidenceSpanId": { "type": "string", "minLength": 2 }
  }
}
