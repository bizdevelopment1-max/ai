{
  "name": "ai-dashboard",
  "version": "1.0.0",
  "description": "Mobile AI business intelligence dashboard with automated updates",
  "main": "app.jsx",
  "type": "module",
  "scripts": {
    "build:browser": "node scripts/build-browser-bundle.mjs",
    "build:mobile-db": "node scripts/build-mobile-ai-business-db.mjs",
    "build:manifest": "node scripts/build-dataset-manifest.mjs",
    "build:slo": "node scripts/build-slo-report.mjs",
    "build:source-compliance": "node scripts/build-source-compliance-catalog.mjs",
    "archive:immutable": "node scripts/archive-immutable-snapshot.mjs",
    "minimize:source-content": "node scripts/minimize-retained-source-content.mjs",
    "normalize:temporal": "node scripts/normalize-temporal-fields.mjs",
    "sync:market-curated": "node scripts/sync-curated-market-records.mjs",
    "verify:volatile": "node scripts/reverify-volatile-metrics.mjs",
    "reverify:volatile": "node scripts/reverify-volatile-metrics.mjs --fetch --write",
    "watch:collections": "node scripts/check-collection-watchdog.mjs --write",
    "collect:sources": "node scripts/collect-source-registry.mjs",
    "validate:mx": "node scripts/validate-mx-intelligence.mjs",
    "test:department": "node scripts/test-department-fit.mjs",
    "test:automation": "node scripts/test-automation.mjs",
    "test:platform": "node scripts/test-data-platform.mjs",
    "test:visual": "node scripts/test-visual-readability.mjs",
    "validate:contracts": "node scripts/validate-data-contracts.mjs --stage=publish",
