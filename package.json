{
  "name": "ai-dashboard",
  "version": "1.0.0",
  "description": "AI news, stocks, and insights dashboard with automated updates",
  "main": "app.jsx",
  "type": "module",
  "scripts": {
    "codex:install": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/install-site-codex.ps1",
    "codex:start": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/start-site-codex.ps1",
    "codex:status": "node node_modules/@openai/codex/bin/codex.js login status",
    "test:codex-bridge": "node scripts/test-site-codex-bridge.mjs",
    "build:browser": "node scripts/build-browser-bundle.mjs",
    "build:mobile-db": "node scripts/build-mobile-ai-business-db.mjs",
    "test:automation": "node scripts/test-automation.mjs",
    "verify": "node scripts/verify-pipeline.mjs",
    "audit": "node scripts/audit-agent.mjs",
    "update:news": "node scripts/crawl-news.mjs",
    "generate:insights": "node scripts/build-insights.mjs",
    "crawl:news": "node scripts/crawl-news.mjs",
    "build:company-news": "node scripts/build-company-news.mjs",
    "crawl:stocks": "node scripts/crawl-stocks.mjs",
    "build:nvidia-investments": "node scripts/build-nvidia-investments.mjs"
  },
  "keywords": [
    "ai",
    "news",
    "stocks",
    "dashboard"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@openai/codex": "0.147.0"
  }
}
